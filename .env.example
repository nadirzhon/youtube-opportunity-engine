# --- Providers (leave blank to use built-in mocks) ---
YOUTUBE_API_KEY=
# Channel list is OPTIONAL — with a key, the worker discovers channels to watch
# by itself from live trending. Set these only to seed/bias the watch set.
YOUTUBE_CHANNEL_IDS=      # optional comma-separated seed channel IDs
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# --- Autonomous discovery ---
YOUTUBE_AUTO_DISCOVER=true   # find channels to watch automatically (no list needed)
YOUTUBE_REGION=US            # trending region
YOUTUBE_CATEGORIES=          # csv of category IDs; blank = a sensible default spread
DISCOVERY_MAX_CHANNELS=40    # channels harvested per discovery pass
DISCOVERY_EVERY_CYCLES=4     # re-discover every N worker cycles (universe grows)
WATCH_SET_CAP=200            # max channels the worker will track
LLM_API_KEY=             # research/concept/script agents (Anthropic/OpenAI)
TTS_API_KEY=             # voice generation
IMAGE_API_KEY=           # thumbnails / visuals

# --- Storage ---
# sqlite by default (zero-setup, survives restarts on a mounted volume).
# For multi-host / high-concurrency, run the compose 'postgres' profile and use:
#   DATABASE_URL=postgresql://yoe:yoe@postgres:5432/yoe
DATABASE_URL=sqlite:////data/yoe.db
REDIS_URL=

# --- Cost & quota guardrails ---
DAILY_BUDGET_USD=10
MONTHLY_BUDGET_USD=200
YOUTUBE_DAILY_QUOTA=10000

# --- 24/7 worker ---
WORKER_INTERVAL_SEC=1800   # seconds between autonomous cycles (default 30 min)
WORKER_AUTO_BUILD=false    # true → auto-build the top opportunity each cycle
WORKER_MIN_OPP_SCORE=65    # only act on opportunities scoring at least this
WORKER_MAX_BACKOFF_SEC=900 # cap on exponential backoff after a failing cycle
LOG_LEVEL=INFO
